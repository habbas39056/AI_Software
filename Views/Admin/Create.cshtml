@model AdwiseAiPlatform.Models.Customer

@{
    ViewData["Title"] = "Add Customer";
}

<div class="mb-4">
    <h2>➕ Add New Customer</h2>
    <p class="text-muted">Provision a new WhatsApp AI agent client.</p>
</div>

<div class="glass-card" style="max-width: 800px;">
    <form asp-action="Create">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Name" class="form-label">Business Name</label>
                <input asp-for="Name" class="form-control" required />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="WhatsAppNumber" class="form-label">WhatsApp Number</label>
                <input asp-for="WhatsAppNumber" class="form-control" required />
            </div>
        </div>

        <h5 class="mt-4 mb-3 border-bottom border-secondary pb-2">Technical Config</h5>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="InstanceName" class="form-label">Evolution API Instance Name</label>
                <input asp-for="InstanceName" class="form-control" placeholder="e.g. adwise_client_1" required />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="N8nWebhookUrl" class="form-label">n8n Workflow Webhook URL</label>
                <input asp-for="N8nWebhookUrl" class="form-control" placeholder="https://..." />
            </div>
        </div>

        <h5 class="mt-4 mb-3 border-bottom border-secondary pb-2">Knowledge Base Initial Training</h5>
        <div class="mb-4">
            <label class="form-label">Paste their initial FAQs, pricing, or instructions here</label>
            <textarea name="InitialKnowledge" class="form-control" rows="5" placeholder="Q: What time are you open? A: 9 AM to 5 PM..."></textarea>
            <small class="text-muted">This will automatically seed the KnowledgeBase table for the AI.</small>
        </div>

        <button type="submit" class="btn-primary-custom w-100 mt-2">Provision Agent & Generate Access</button>
    </form>
</div>
