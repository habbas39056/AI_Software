@model AdwiseAiPlatform.Models.Customer
@{ ViewData["Title"] = "Onboard Client"; }

<div class="step-indicator">
    <span class="step-badge" id="step-badge-text">Step 1 of 3</span>
</div>

<div class="stepper-header">
    <div class="step-item active" id="step1-header">
        <div class="step-circle">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" id="step1-check" style="display:none;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <span id="step1-num">1</span>
        </div>
        <div class="step-label">CLIENT IDENTITY</div>
    </div>
    <div class="step-item" id="step2-header">
        <div class="step-circle">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" id="step2-check" style="display:none;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <span id="step2-num">2</span>
        </div>
        <div class="step-label">TECHNICAL CONFIG</div>
    </div>
    <div class="step-item" id="step3-header">
        <div class="step-circle">3</div>
        <div class="step-label">INITIAL KNOWLEDGE</div>
    </div>
</div>

<div style="max-width: 800px; margin: 0 auto;">
    <form method="post" action="/Admin/AddCustomer" id="onboardForm">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="error-msg" style="margin-bottom: 2rem;">
                <ul style="margin: 0; padding-left: 1.5rem;">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }
        
        <!-- STEP 1 -->
        <div id="step1-content">
            <h1 style="margin-bottom: 0.5rem;">New Customer Onboarding</h1>
            <p class="subtitle">Standardize your client integration process. Fill out the details below to initialize the environment and generate secure credentials.</p>
            
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 2rem; margin-bottom: 1rem;">
                <div style="background: rgba(16, 185, 129, 0.1); color: var(--brand-green); width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                </div>
                <div>
                    <span style="font-size: 0.65rem; font-weight: 800; color: var(--brand-green); letter-spacing: 1px;">PART 01</span>
                    <h2 style="margin: 0; font-size: 1.25rem;">Client Identity</h2>
                </div>
            </div>

            <div class="white-box">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
                    <div>
                        <label class="form-label">Customer Name <svg class="info-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></label>
                        <div class="input-group">
                            <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                            <input type="text" name="Name" class="glass-input with-icon" required placeholder="e.g. Acme Corp" />
                        </div>
                    </div>
                    <div>
                        <label class="form-label">Business Entity <svg class="info-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></label>
                        <div class="input-group">
                            <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                            <input type="text" name="BusinessEntity" class="glass-input with-icon" placeholder="e.g. Acme Services LLC" />
                        </div>
                    </div>
                </div>

                <div style="margin-bottom: 1.5rem;">
                    <label class="form-label">Primary Admin Email <svg class="info-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></label>
                    <div class="input-group" style="margin-bottom: 0.25rem;">
                        <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                        <input type="email" name="Email" class="glass-input with-icon" required placeholder="admin@customer.com" style="margin-bottom: 0;" />
                    </div>
                    <span style="font-size: 0.7rem; color: var(--text-muted);">This email will receive the automatically generated system access credentials.</span>
                </div>
                <div>
                    <label class="form-label">WhatsApp Number</label>
                    <div class="input-group" style="margin-bottom: 1.5rem;">
                        <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                        <input type="text" name="WhatsAppNumber" class="glass-input with-icon" required placeholder="+1234567890" />
                    </div>
                </div>

                <div>
                    <label class="form-label">System Access Password</label>
                    <div class="input-group">
                        <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                        <input type="password" name="Password" class="glass-input with-icon" placeholder="Default: 123456" />
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 1.5rem;">
                    <div>
                        <label class="form-label">Subscription Days <svg class="info-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></label>
                        <div class="input-group">
                            <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            <input type="number" name="SubscriptionDays" class="glass-input with-icon" value="30" min="1" placeholder="30" />
                        </div>
                        <span style="font-size: 0.7rem; color: var(--text-muted);">How many days the client can use the portal.</span>
                    </div>
                    <div>
                        <label class="form-label">Monthly Fee (PKR)</label>
                        <div class="input-group">
                            <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            <input type="number" name="MonthlyFee" class="glass-input with-icon" value="14000" min="0" placeholder="14000" />
                        </div>
                    </div>
                </div>

                <div style="margin-top: 2rem; display: flex; justify-content: flex-end;">
                    <button type="button" class="btn-primary box-shadow" onclick="nextStep(2)">Continue to Config <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg></button>
                </div>
            </div>
        </div>

        <!-- STEP 2 -->
        <div id="step2-content" style="display: none;">
            <h1 style="text-align: center; margin-bottom: 0.5rem;">Technical Configuration</h1>
            <p class="subtitle" style="text-align: center;">Configure the connection between your instance and the automation engine.</p>
            
            <div class="white-box" style="margin-top: 2rem;">
                
                <!-- Section 1 -->
                <div style="display: flex; gap: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--card-border); padding-bottom: 1.5rem;">
                    <div style="background: rgba(16, 185, 129, 0.1); color: var(--brand-green); width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>
                    </div>
                    <div style="flex: 1;">
                        <h3 style="margin: 0 0 0.25rem 0; font-size: 1rem;">Instance Details</h3>
                        <p style="margin: 0 0 1rem 0; font-size: 0.8rem; color: var(--text-secondary);">Your dedicated SaaS subdomain environment.</p>
                        
                        <label class="form-label">Instance Name <svg class="info-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></label>
                        <div class="input-group">
                            <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>
                            <input type="text" name="InstanceName" class="glass-input with-icon" required placeholder="acme-corp.onboarding.io" style="margin-bottom: 0;" />
                        </div>
                    </div>
                </div>

                <!-- Section 2 -->
                <div style="display: flex; gap: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--card-border); padding-bottom: 1.5rem;">
                    <div style="background: rgba(59, 130, 246, 0.1); color: var(--accent-blue); width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                    </div>
                    <div style="flex: 1;">
                        <h3 style="margin: 0 0 0.25rem 0; font-size: 1rem;">API Credentials</h3>
                        <p style="margin: 0 0 1rem 0; font-size: 0.8rem; color: var(--text-secondary);">Secure keys for backend service integration.</p>
                        
                         <label class="form-label">Evolution API Key <svg class="info-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></label>
                        <div class="input-group">
                            <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg>
                            <input type="text" name="ConfigApiKey" class="glass-input with-icon" placeholder="Enter your evolution api key" style="margin-bottom: 0;" />
                            <svg style="position: absolute; right: 1rem; color: var(--text-muted); width: 18px; height: 18px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                        </div>
                    </div>
                </div>

                <!-- Section 3 -->
                <div style="display: flex; gap: 1rem;">
                    <div style="background: rgba(245, 158, 11, 0.1); color: var(--accent-orange); width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
                    </div>
                    <div style="flex: 1;">
                        <h3 style="margin: 0 0 0.25rem 0; font-size: 1rem;">Webhooks</h3>
                        <p style="margin: 0 0 1rem 0; font-size: 0.8rem; color: var(--text-secondary);">Real-time data synchronization settings.</p>
                        
                         <label class="form-label">n8n Webhook URL <svg class="info-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></label>
                        <div class="input-group">
                            <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                            <input type="url" name="N8nWebhookUrl" class="glass-input with-icon" placeholder="https://n8n.workflow.service/hooks/custom-onboarding" style="margin-bottom: 0;" />
                        </div>
                    </div>
                </div>

                <div class="warning-box" style="margin-top: 1.5rem; background: #fef2f2; border-color: #fecaca; color: #ef4444;">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                    Please provide a valid Evolution API Key (minimum 8 characters) to proceed with the configuration and generate credentials.
                </div>

                <div style="margin-top: 2rem; display: flex; justify-content: space-between;">
                    <button type="button" class="btn-secondary" onclick="nextStep(1)">Back</button>
                    <button type="button" class="btn-primary" onclick="nextStep(3)">Continue to Knowledge <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg></button>
                </div>
                <!-- Bottom Note -->
                <div style="text-align: center; font-size: 0.7rem; color: var(--text-muted); margin-top: 2rem; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                    <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg> End-to-end encrypted
                </div>
            </div>
        </div>

        <!-- STEP 3 -->
        <div id="step3-content" style="display: none;">
            <h1 style="text-align: center; margin-bottom: 0.5rem;">Initial Base Knowledge</h1>
            <p class="subtitle" style="text-align: center;">Paste the company FAQs and capabilities to initialize the AI's brain.</p>
            
            <div class="white-box" style="margin-top: 2rem;">
                 <label class="form-label">Initial Context (Optional)</label>
                 <textarea name="InitialKnowledge" class="glass-input" rows="8" placeholder="Enter facts, prices, and services..."></textarea>
                 
                  <div style="margin-top: 2rem; display: flex; justify-content: space-between;">
                    <button type="button" class="btn-secondary" onclick="nextStep(2)">Back</button>
                    <button type="submit" class="btn-primary" style="background: var(--brand-green);">Finalize & Create Tenant</button>
                </div>
            </div>
        </div>

    </form>
</div>

@section Scripts {
    <script>
        function nextStep(step) {
            document.getElementById('step1-content').style.display = 'none';
            document.getElementById('step2-content').style.display = 'none';
            document.getElementById('step3-content').style.display = 'none';
            
            document.getElementById('step' + step + '-content').style.display = 'block';
            document.getElementById('step-badge-text').innerText = 'Step ' + step + ' of 3';

            // Reset headers
            document.querySelectorAll('.step-item').forEach(el => el.classList.remove('active', 'completed'));
            document.getElementById('step1-num').style.display = 'inline';
            document.getElementById('step1-check').style.display = 'none';
            document.getElementById('step2-num').style.display = 'inline';
            document.getElementById('step2-check').style.display = 'none';

            if(step === 1) {
                document.getElementById('step1-header').classList.add('active');
            } else if (step === 2) {
                document.getElementById('step1-header').classList.add('completed');
                document.getElementById('step1-num').style.display = 'none';
                document.getElementById('step1-check').style.display = 'inline-flex';
                document.getElementById('step2-header').classList.add('active');
            } else if (step === 3) {
                document.getElementById('step1-header').classList.add('completed');
                document.getElementById('step1-num').style.display = 'none';
                document.getElementById('step1-check').style.display = 'inline-flex';
                document.getElementById('step2-header').classList.add('completed');
                document.getElementById('step2-num').style.display = 'none';
                document.getElementById('step2-check').style.display = 'inline-flex';
                document.getElementById('step3-header').classList.add('active');
            }
        }
    </script>
}
