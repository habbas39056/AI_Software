@model AdwiseAiPlatform.Models.Customer
@{ ViewData["Title"] = Model.Name + " - Knowledge Base"; }

<div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem;">
    <div>
        <a href="/Admin/Details/@Uri.EscapeDataString(Model.WhatsAppNumber)" class="btn-secondary" style="font-size: 0.85rem; padding: 0.4rem 0.8rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem; margin-bottom: 1rem;">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg> Back to 360 View
        </a>
        <h1>@Model.Name - Knowledge Base</h1>
        <p class="subtitle" style="margin-bottom: 0;">Manage bot knowledge and custom mappings.</p>
    </div>
</div>

<div class="white-box" style="margin-bottom: 1.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1rem;">
        <h2 class="box-title">Knowledge Base</h2>
        <button class="icon-button" style="color: var(--brand-green);" onclick="document.getElementById('addKnowledgeModal').style.display='flex'"><svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg></button>
    </div>
    
    <table class="glass-table">
        <thead>
            <tr><th>Topic/Question</th><th>Content Mapping</th><th style="text-align: right;">Action</th></tr>
        </thead>
        <tbody>
            @if(Model.KnowledgeBases == null || !Model.KnowledgeBases.Any()) {
                <tr><td colspan="3" style="color: var(--text-muted); text-align: center;">No knowledge uploaded yet. Bot will use default prompt.</td></tr>
            }
            else {
                @foreach(var kb in Model.KnowledgeBases) {
                    <tr>
                        <td style="font-weight: 600; width: 30%;">@kb.Topic</td>
                        <td style="font-size: 0.85rem; color: var(--text-secondary);">@kb.Content</td>
                        <td style="text-align: right;">
                            <form method="post" action="/Admin/DeleteKnowledge" style="margin:0;">
                                <input type="hidden" name="customerId" value="@Model.WhatsAppNumber" />
                                <input type="hidden" name="id" value="@kb.Id" />
                                <button type="submit" style="background:none; border:none; color:#ef4444; cursor:pointer;"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg></button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Add Knowledge Modal -->
<div id="addKnowledgeModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center;">
    <div class="white-box" style="width: 500px; max-width: 90%; position: relative;">
        <button style="position:absolute; top:1rem; right:1rem; background:none; border:none; cursor:pointer;" onclick="document.getElementById('addKnowledgeModal').style.display='none'"><svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>
        <h2 class="box-title">Add Knowledge Article</h2>
        <form method="post" action="/Admin/AddKnowledge">
            <input type="hidden" name="customerId" value="@Model.WhatsAppNumber" />
            <div style="margin-bottom: 1rem;">
                <label class="form-label">Topic / Question</label>
                <input type="text" name="Topic" class="glass-input" required placeholder="e.g. Refund Policy" />
            </div>
            <div style="margin-bottom: 1.5rem;">
                <label class="form-label">Content / Mapping</label>
                <textarea name="Content" class="glass-input" rows="4" required placeholder="e.g. We offer a 30-day money back guarantee..."></textarea>
            </div>
            <button type="submit" class="btn-primary" style="width: 100%;">Add Article</button>
        </form>
    </div>
</div>
