@model IEnumerable<AdwiseAiPlatform.Models.Customer>
@{ ViewData["Title"] = "Dashboard"; }

<div class="stat-cards-grid">
    <div class="stat-card blue">
        <div class="stat-header">
            <h3 class="stat-title">Total Active Clients</h3>
            <div class="stat-icon-wrapper">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
            </div>
        </div>
        <p class="stat-value">@(ViewBag.ActiveAgentsCount ?? 0)</p>
        <div class="stat-change positive">
            <span>Live</span> <span>Active Subscriptions</span>
        </div>
    </div>

    <div class="stat-card blue">
        <div class="stat-header">
            <h3 class="stat-title">Total Deployed Agents</h3>
            <div class="stat-icon-wrapper">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
        </div>
        <p class="stat-value">@(ViewBag.TotalAgents ?? 0)</p>
        <div class="stat-change positive">
            <span>+@(ViewBag.TotalAgents ?? 0)</span> <span>Total Instances</span>
        </div>
    </div>

    <div class="stat-card green">
        <div class="stat-header">
            <h3 class="stat-title">Monthly Revenue (PKR)</h3>
            <div class="stat-icon-wrapper">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
        </div>
        <p class="stat-value">@((ViewBag.EstimatedRevenue ?? 0).ToString("N0"))</p>
        <div class="stat-change positive">
            <span>+100%</span> <span>New Contracts</span>
        </div>
    </div>

    <div class="stat-card orange">
        <div class="stat-header">
            <h3 class="stat-title">Total Leads Captured</h3>
            <div class="stat-icon-wrapper">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>
            </div>
        </div>
        <p class="stat-value">@ViewBag.TotalLeads</p>
        <div class="stat-change positive">
            <span>+5.4k</span> <span>Global operations</span>
        </div>
    </div>

    <div class="stat-card green">
        <div class="stat-header">
            <h3 class="stat-title">System Health</h3>
            <div class="stat-icon-wrapper">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            </div>
        </div>
        <p class="stat-value">99.9%</p>
        <div class="stat-change positive">
            <span style="font-weight: 700;">Optimal</span> <span>All nodes operational</span>
        </div>
    </div>
</div>

<div class="main-wrapper">
    <!-- LEFT SIDE -->
    <div class="left-col">
        <div class="white-box">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <h2 class="box-title">Revenue Growth Forecast</h2>
                    <p class="box-subtitle">Comprehensive comparison between actual and projected growth (PKR).</p>
                </div>
                <div class="badge active" style="display: flex; align-items: center; gap: 0.25rem;">
                    <span style="width: 6px; height: 6px; background: var(--accent-green); border-radius: 50%; display: inline-block;"></span> Live Feed
                </div>
            </div>
            <!-- Mock Chart Area -->
            <div style="height: 300px; display: flex; align-items: flex-end; padding-top: 2rem; position: relative;">
                <!-- Dotted projection line -->
                <svg style="position: absolute; width: 100%; height: 100%;" preserveAspectRatio="none">
                    <path d="M0 250 L150 200 L300 150 L450 100 L600 50" stroke="#93c5fd" stroke-width="2" stroke-dasharray="6,6" fill="none" />
                    <path d="M0 240 L150 180 L300 130 L450 70 L600 20" stroke="var(--brand-green)" stroke-width="3" fill="none" />
                    <!-- Dots -->
                    <circle cx="150" cy="180" r="4" fill="var(--brand-green)" />
                    <circle cx="300" cy="130" r="4" fill="var(--brand-green)" />
                    <circle cx="450" cy="70" r="4" fill="var(--brand-green)" />
                    <circle cx="600" cy="20" r="4" fill="var(--brand-green)" />
                </svg>
            </div>
            <div style="display: flex; justify-content: space-between; margin-top: 1rem; color: var(--text-muted); font-size: 0.8rem;">
                <span>Jan</span><span>Feb</span><span>Mar</span><span>Apr</span><span>May</span><span>Jun</span>
            </div>
        </div>

        <div class="action-grid">
            <div class="action-card">
                <div class="action-icon green"><svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M11.251.068a.5.5 0 0 1 .227.58L9.677 6.5H13a.5.5 0 0 1 .364.843l-8 8.5a.5.5 0 0 1-.842-.49L6.323 9.5H3a.5.5 0 0 1-.364-.843l8-8.5a.5.5 0 0 1 .615-.09z"/></svg></div>
                <h4 class="action-title">Deploy Agent</h4>
                <p class="action-desc">One-click AI implementation</p>
            </div>
            <div class="action-card">
                <div class="action-icon blue"><svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg></div>
                <h4 class="action-title">Sync Data</h4>
                <p class="action-desc">External API bridge sync</p>
            </div>
            <div class="action-card">
                <div class="action-icon orange"><svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg></div>
                <h4 class="action-title">Audit Logs</h4>
                <p class="action-desc">Compliance check records</p>
            </div>
        </div>
    </div>

    <!-- RIGHT SIDE -->
    <div class="right-col">
        <div class="white-box" style="height: 100%;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2rem;">
                <h2 class="box-title">Recent Activity</h2>
                <a href="#" style="color: var(--brand-green); text-decoration: none; font-size: 0.85rem; font-weight: 600;">View All</a>
            </div>

            <div class="timeline">
                @if(Model != null && !Model.Any()) {
                    <p style="color: var(--text-muted); font-size: 0.85rem;">No recent platform activity found.</p>
                }

                @if(Model != null) {
                    foreach(var customer in Model.OrderByDescending(c => c.SubscriptionExpiry).Take(3)) {
                    <div class="timeline-item">
                        <div class="timeline-icon" style="background: var(--text-primary); color: white;"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg></div>
                        <div class="timeline-content">
                            <div class="timeline-header">
                                <h4 class="timeline-title">New Client Added: @customer.Name</h4>
                                <span class="timeline-time">Recently</span>
                            </div>
                            <p class="timeline-desc">Enterprise AI Chatbot Implementation Initiated.</p>
                            <span class="tag">client</span>
                        </div>
                    </div>
                    }
                }

                @if(ViewBag.RecentLeads != null) {
                    foreach(var lead in ViewBag.RecentLeads) {
                    <div class="timeline-item">
                        <div class="timeline-icon" style="background: #f59e0b; color: white;"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg></div>
                        <div class="timeline-content">
                            <div class="timeline-header">
                                <h4 class="timeline-title">Global Lead Captured</h4>
                                <span class="timeline-time">@lead.LastMessageAt.ToShortDateString()</span>
                            </div>
                            <p class="timeline-desc">@lead.Summary</p>
                            <span class="tag" style="background: #ecfdf5; color: var(--brand-green);">lead</span>
                        </div>
                    </div>
                    }
                }
            </div>

            <button style="width: 100%; margin-top: 2rem; background: white; border: 1px solid var(--card-border); padding: 0.75rem; border-radius: 8px; font-weight: 600; color: var(--text-secondary); cursor: pointer; transition: all 0.2s;">
                Load More Activity
            </button>
        </div>
    </div>
</div>
