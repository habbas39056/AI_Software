@model IEnumerable<AdwiseAiPlatform.Models.Customer>
@{ ViewData["Title"] = "CRM & Clients"; }

<div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem;">
    <div>
        <h1 style="margin-top: 0;">Global Clients Roster</h1>
        <p class="subtitle" style="margin-bottom: 0;">Manage your agency's active clients, review stats, and modify configurations.</p>
    </div>
    <div>
        <a href="/Admin/AddCustomer" class="btn-primary" style="background: var(--brand-green);">
            + Onboard New Client
        </a>
    </div>
</div>

<div class="white-box" style="padding: 0;">
    <table class="glass-table">
        <thead>
            <tr>
                <th>Customer Identity</th>
                <th>Instance Name</th>
                <th>Auth (WhatsApp/Email)</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if(!Model.Any()) {
                <tr><td colspan="5" style="text-align: center; color: var(--text-muted); padding: 4rem;">No clients installed. Go to Onboard New Client to begin.</td></tr>
            }
            @foreach(var c in Model) {
                <tr>
                    <td style="font-weight: 600;">
                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                            <div style="width: 32px; height: 32px; background: rgba(16, 185, 129, 0.1); color: var(--brand-green); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700;">
                                @(!string.IsNullOrEmpty(c.Name) ? c.Name.Substring(0, 1) : "C")
                            </div>
                            <div>
                                <span style="display: block;">@c.Name</span>
                                <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: 400;">@c.BusinessEntity</span>
                            </div>
                        </div>
                    </td>
                    <td>
                        @if (c.Agents != null && c.Agents.Any()) {
                            foreach(var agent in c.Agents) {
                                <div style="margin-bottom: 0.2rem;">
                                    <span style="background: var(--main-bg); padding: 0.2rem 0.5rem; border-radius: 4px; border: 1px solid var(--card-border); font-size: 0.7rem; font-weight: 600;">@agent.InstanceName</span>
                                </div>
                            }
                        } else {
                            <span style="color: var(--text-muted); font-size: 0.75rem;">No Agents</span>
                        }
                    </td>
                    <td style="font-size: 0.8rem; color: var(--text-secondary);">
                        <div style="display: flex; align-items: center; gap: 0.4rem; justify-content: flex-start; margin-bottom: 0.2rem;">
                            <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg> @c.Email
                        </div>
                        <div style="display: flex; align-items: center; gap: 0.4rem; justify-content: flex-start;">
                            <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg> @c.WhatsAppNumber
                        </div>
                    </td>
                    <td><span class="badge @(c.SubscriptionStatus == "Active" ? "active" : c.SubscriptionStatus == "GracePeriod" ? "grace" : "suspended")">@c.SubscriptionStatus</span></td>
                    <td>
                        <div style="display: flex; gap: 0.5rem; align-items: center;">
                            <a href="/Admin/Details/@Uri.EscapeDataString(c.WhatsAppNumber)" class="btn-secondary" style="font-size: 0.75rem; padding: 0.35rem 0.8rem; text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem;"><svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg> 360 View</a>
                            <a href="/Admin/EditCustomer/@Uri.EscapeDataString(c.WhatsAppNumber)" style="color: var(--text-muted); padding: 0.4rem; display: flex; align-items: center; justify-content: center; border-radius: 4px; transition: 0.2s;" onmouseover="this.style.background='var(--main-bg)'; this.style.color='var(--text-primary)';" onmouseout="this.style.background='transparent'; this.style.color='var(--text-muted)';"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg></a>
                            
                            <form method="post" action="/Admin/DeleteCustomer/@Uri.EscapeDataString(c.WhatsAppNumber)" onsubmit="return confirm('CRITICAL: This will permanently delete this client and ALL their AI agents. Are you sure?')" style="margin: 0;">
                                <button type="submit" style="background: transparent; border: none; color: #ef4444; padding: 0.4rem; cursor: pointer; display: flex; align-items: center; justify-content: center; border-radius: 4px; transition: 0.2s;" onmouseover="this.style.background='#fee2e2';" onmouseout="this.style.background='transparent';">
                                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
