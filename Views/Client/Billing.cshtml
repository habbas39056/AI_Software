@model AdwiseAiPlatform.Models.Customer
@{ ViewData["Title"] = "Billing Details"; }

@{
    int daysLeft = 0;
    if (Model.SubscriptionExpiry.HasValue)
    {
        daysLeft = (int)(Model.SubscriptionExpiry.Value - DateTime.UtcNow).TotalDays;
        if (daysLeft < 0) daysLeft = 0;
    }
    double progressPercent = Model.SubscriptionDays > 0 ? (double)(Model.SubscriptionDays - daysLeft) / Model.SubscriptionDays * 100 : 0;
    if (progressPercent > 100) progressPercent = 100;
    string barColor = daysLeft <= 3 ? "#ef4444" : daysLeft <= 10 ? "#f59e0b" : "#10B981";
}

<h1 style="margin-top: 0; font-size: 1.5rem; margin-bottom: 2rem;">Billing & Subscription Management</h1>

<div class="responsive-grid grid-2">
    <!-- Subscription Overview -->
    <div style="background: white; border: 1px solid var(--card-border); border-radius: 12px; padding: 2rem;">
        <h3 style="margin-top: 0; color: var(--text-primary); margin-bottom: 1.5rem;">Subscription Overview</h3>
        
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; border-bottom: 1px solid var(--card-border); padding-bottom: 1.5rem;">
            <div>
                <div style="font-size: 1.2rem; font-weight: 700; color: #0f172a; margin-bottom: 0.2rem;">Enterprise AI Plan</div>
                <div style="font-size: 0.85rem; color: @(Model.SubscriptionStatus == "Active" ? "#10b981" : "#ef4444"); font-weight: 600;">Status: @Model.SubscriptionStatus</div>
            </div>
            <div style="text-align: right;">
                <div style="font-size: 1.5rem; font-weight: 700; color: #0f172a;">PKR @Model.MonthlyFee.ToString("N0")</div>
                <div style="font-size: 0.75rem; color: #64748b;">per cycle (@Model.SubscriptionDays days)</div>
            </div>
        </div>

        <!-- Days Progress -->
        <div style="margin-bottom: 1.5rem;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 0.8rem; font-weight: 600;">
                <span style="color: #64748b;">SUBSCRIPTION USAGE</span>
                <span style="color: @barColor;">@daysLeft DAYS REMAINING</span>
            </div>
            <div style="width: 100%; height: 10px; border-radius: 6px; background: #e2e8f0; overflow: hidden;">
                <div style="width: @(progressPercent)%; height: 100%; background: @barColor; border-radius: 6px; transition: width 0.5s ease;"></div>
            </div>
        </div>

        <div style="margin-bottom: 1.5rem;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 0.9rem;">
                <span style="color: #64748b;">Subscription Started</span>
                <span style="font-weight: 600;">@(Model.SubscriptionExpiry?.AddDays(-Model.SubscriptionDays).ToString("MMM dd, yyyy") ?? "N/A")</span>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 0.9rem;">
                <span style="color: #64748b;">Expiry Date</span>
                <span style="font-weight: 600;">@Model.SubscriptionExpiry?.ToString("MMMM dd, yyyy")</span>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 0.9rem;">
                <span style="color: #64748b;">Assigned Days</span>
                <span style="font-weight: 600;">@Model.SubscriptionDays days</span>
            </div>
        </div>

        @if (daysLeft <= 10 && daysLeft > 3) {
        <div style="background: #fef3c7; border: 1px solid #fbbf24; border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
            <div style="font-weight: 700; color: #92400e; font-size: 0.9rem;">⏰ Payment Reminder</div>
            <div style="font-size: 0.8rem; color: #92400e; margin-top: 0.25rem;">Only @daysLeft days left. Please ensure your billing is cleared before expiry to avoid service interruption.</div>
        </div>
        } else if (daysLeft <= 3 && daysLeft > 0) {
        <div style="background: #fee2e2; border: 1px solid #ef4444; border-radius: 8px; padding: 1rem; margin-bottom: 1rem; animation: alertPulse 2s infinite;">
            <div style="font-weight: 800; color: #991b1b; font-size: 0.95rem;">⚠ URGENT: @daysLeft day(s) remaining!</div>
            <div style="font-size: 0.8rem; color: #991b1b; margin-top: 0.25rem;">Your portal will be BLOCKED after expiry. Pay now to avoid losing access.</div>
        </div>
        <style>@@keyframes alertPulse { 0%,100% { box-shadow: 0 0 0 0 rgba(239,68,68,0.3); } 50% { box-shadow: 0 0 0 8px rgba(239,68,68,0); } }</style>
        }

        <a href="https://wa.me/923346565253?text=Hi%2C%20I%20want%20to%20renew%20my%20subscription" target="_blank" style="display: block; width: 100%; text-align: center; background: #10B981; color: white; padding: 0.9rem; border-radius: 8px; font-weight: 700; text-decoration: none; border: none; cursor: pointer; font-size: 0.95rem;">
            💬 Contact Admin to Renew
        </a>
    </div>

    <!-- Features & Info -->
    <div style="background: white; border: 1px solid var(--card-border); border-radius: 12px; padding: 2rem;">
        <h3 style="margin-top: 0; color: var(--text-primary); margin-bottom: 1.5rem;">Plan Features</h3>
        <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem;">
            <div style="display: flex; align-items: center; gap: 0.8rem; font-size: 0.9rem; color: #475569;">
                <svg width="20" height="20" fill="none" stroke="#10b981" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                Unlimited Messages & Leads
            </div>
            <div style="display: flex; align-items: center; gap: 0.8rem; font-size: 0.9rem; color: #475569;">
                <svg width="20" height="20" fill="none" stroke="#10b981" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                Unlimited Knowledge Base Rules
            </div>
            <div style="display: flex; align-items: center; gap: 0.8rem; font-size: 0.9rem; color: #475569;">
                <svg width="20" height="20" fill="none" stroke="#10b981" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                AI Agent Auto-Responses (24/7)
            </div>
            <div style="display: flex; align-items: center; gap: 0.8rem; font-size: 0.9rem; color: #475569;">
                <svg width="20" height="20" fill="none" stroke="#10b981" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                Priority SLA Support
            </div>
        </div>

        <!-- Billing History Placeholder -->
        <h3 style="color: var(--text-primary); margin-bottom: 1rem; padding-top: 1.5rem; border-top: 1px solid var(--card-border);">Billing History</h3>
        <div style="text-align: center; padding: 2rem; color: #94a3b8; font-size: 0.85rem; background: #f8fafc; border-radius: 8px; border: 1px dashed var(--card-border);">
            <svg width="36" height="36" fill="none" stroke="#cbd5e1" viewBox="0 0 24 24" style="margin-bottom: 0.5rem;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
            <div>Billing history will appear here after your first renewal cycle.</div>
        </div>
    </div>
</div>
