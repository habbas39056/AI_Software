@model AdwiseAiPlatform.Models.Customer
@{ ViewData["Title"] = "Lead Center"; }

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
        <h1 style="margin: 0; font-size: 1.5rem; color: var(--text-primary);">Lead Center</h1>
        <p style="margin: 0.2rem 0 0 0; color: var(--text-muted); font-size: 0.9rem;">Review and export leads captured by your AI agent.</p>
    </div>
    <div style="background: rgba(16, 185, 129, 0.1); color: #10B981; padding: 0.5rem 1rem; border-radius: 8px; font-weight: 600; font-size: 0.85rem;">
        Total Leads: @(Model.Leads?.Count ?? 0)
    </div>
</div>

<div style="background: white; border: 1px solid var(--card-border); border-radius: 12px; overflow: hidden;">
    <div style="padding: 1.5rem; border-bottom: 1px solid var(--card-border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <h3 style="margin: 0; font-size: 1.1rem; color: var(--text-primary);">Captured Contacts</h3>
        <button style="background: white; border: 1px solid var(--card-border); padding: 0.4rem 1rem; border-radius: 6px; font-size: 0.8rem; font-weight: 600; color: #475569; display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            Export CSV
        </button>
    </div>

    @if (Model.Leads == null || !Model.Leads.Any()) {
        <div style="text-align: center; padding: 4rem; color: #94a3b8;">
            <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="opacity: 0.6; margin-bottom: 1rem;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
            <p style="margin: 0; font-size: 0.95rem;">No leads captured yet.</p>
            <p style="margin: 0.3rem 0 0 0; font-size: 0.8rem;">Ensure your WhatsApp is connected and AI is set to Active.</p>
        </div>
    } else {
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; min-width: 600px;">
                <thead>
                    <tr style="background: #f8fafc; border-bottom: 1px solid var(--card-border);">
                        <th style="padding: 1rem 1.5rem; font-size: 0.75rem; font-weight: 700; color: #64748b; letter-spacing: 1px;">DATE/TIME</th>
                        <th style="padding: 1rem 1.5rem; font-size: 0.75rem; font-weight: 700; color: #64748b; letter-spacing: 1px;">LEAD NAME</th>
                        <th style="padding: 1rem 1.5rem; font-size: 0.75rem; font-weight: 700; color: #64748b; letter-spacing: 1px;">PHONE NUMBER</th>
                        <th style="padding: 1rem 1.5rem; font-size: 0.75rem; font-weight: 700; color: #64748b; letter-spacing: 1px;">LEAD SUMMARY</th>
                        <th style="padding: 1rem 1.5rem; font-size: 0.75rem; font-weight: 700; color: #64748b; letter-spacing: 1px;">LEAD STATUS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lead in Model.Leads!.OrderByDescending(l => l.LastMessageAt)) {
                        <tr style="border-bottom: 1px solid var(--card-border);">
                            <td style="padding: 1rem 1.5rem; color: #64748b; font-size: 0.85rem;">
                                @lead.LastMessageAt.ToString("MMM dd, yyyy HH:mm")
                            </td>
                            <td style="padding: 1rem 1.5rem; font-weight: 600; color: #0f172a; font-size: 0.9rem;">
                                @(string.IsNullOrEmpty(lead.Name) ? "Anonymous" : lead.Name)
                            </td>
                            <td style="padding: 1rem 1.5rem; color: #475569; font-size: 0.9rem;">
                                @lead.PhoneNumber
                            </td>
                            <td style="padding: 1rem 1.5rem; color: #475569; font-size: 0.85rem; max-width: 300px;">
                                @lead.Summary
                            </td>
                            <td style="padding: 1rem 1.5rem;">
                                <span style="background: rgba(16, 185, 129, 0.1); color: #10B981; padding: 0.2rem 0.6rem; border-radius: 20px; font-size: 0.75rem; font-weight: 700;">
                                    @lead.Score
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
