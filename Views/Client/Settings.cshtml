@model AdwiseAiPlatform.Models.Customer
@{ ViewData["Title"] = "Agent Settings"; }

<h1 style="margin-top: 0; font-size: 1.5rem; margin-bottom: 2rem;">Agent Config & Security</h1>

<div class="dashboard-container" style="max-width: 1000px;">
    <!-- Agent Instances -->
    <div style="background: white; border: 1px solid var(--card-border); border-radius: 12px; padding: 2rem; margin-bottom: 2rem;">
        <h3 style="margin-top: 0; color: var(--text-primary); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
            Active Agent Instances
        </h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1rem;">
            @if (Model.Agents != null && Model.Agents.Any()) {
                foreach(var agent in Model.Agents) {
                    <div style="background: #f8fafc; padding: 1rem; border-radius: 10px; border: 1px solid var(--card-border); display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <div style="font-weight: 700; color: #0f172a; font-size: 0.9rem;">@agent.InstanceName</div>
                            <div style="font-size: 0.75rem; color: @(agent.IsActive ? "#10B981" : "#ef4444"); font-weight: 600;">
                                @(agent.IsActive ? "● ONLINE" : "○ PAUSED")
                            </div>
                        </div>
                        <form method="post" action="/Client/ToggleAgent" style="margin:0;">
                            <input type="hidden" name="IsActive" value="@(agent.IsActive ? "false" : "true")" />
                            <button type="submit" style="background: white; border: 1px solid var(--card-border); padding: 0.3rem 0.6rem; border-radius: 6px; font-size: 0.7rem; font-weight: 700; cursor: pointer; transition: 0.2s;" onmouseover="this.style.background='#f1f5f9';" onmouseout="this.style.background='white';">
                                @(agent.IsActive ? "Pause" : "Resume")
                            </button>
                        </form>
                    </div>
                }
            } else {
                <div style="grid-column: 1 / -1; text-align: center; padding: 2rem; color: #64748b; font-size: 0.9rem; background: #f8fafc; border-radius: 12px; border: 1px dashed var(--card-border);">
                    No AI agent instances detected. Please connect an instance below.
                </div>
            }
        </div>
    </div>

    <!-- WhatsApp AI Engine Sync -->
    <div style="background: white; border: 1px solid var(--card-border); border-radius: 12px; padding: 2rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
             <h3 style="margin: 0; font-size: 1.1rem; color: var(--text-primary);">WhatsApp AI Engine Sync</h3>
             <form id="qrForm" style="margin: 0;">
                <input type="hidden" id="instanceNameField" value="@Model.InstanceName" />
                <button type="button" class="btn-primary" id="generateQRBtn" style="padding: 0.5rem 1rem; font-size: 0.8rem; background: #10B981; border: none; border-radius: 6px; color: white; cursor: pointer; font-weight: 600;">Connect Instance</button>
            </form>
        </div>
        
        <div id="qrCodeContainer" style="margin-top: 1rem; text-align: center; background: #f8fafc; padding: 2rem; border-radius: 8px; border: 1px dashed var(--card-border);">
            <p style="color: #64748b; font-size: 0.85rem; margin: 0;">Click 'Connect Instance' to generate a fresh pairing QR code.</p>
        </div>

        <p style="font-size: 0.8rem; color: #94a3b8; margin-top: 1.5rem; margin-bottom: 0;">
            To modify internal logic or transfer ownership, please contact Support.
        </p>
    </div>
</div>

@section Scripts {
    <script>
        var btn = document.getElementById('generateQRBtn');
        if(btn) {
            btn.addEventListener('click', function() {
                var inst = document.getElementById('instanceNameField').value;
                document.getElementById('qrCodeContainer').innerHTML = '<div style="color:#10b981; font-weight: 600;">Contacting Evolution API...</div>';
                
                fetch('/api/evolution/qr/' + encodeURIComponent(inst))
                .then(r => r.json())
                .then(data => {
                    if(data.base64) {
                        document.getElementById('qrCodeContainer').innerHTML = '<img src="' + data.base64 + '" style="width: 250px; height: 250px; border-radius: 12px; border: 1px solid var(--card-border); background: white; padding: 10px;" />';
                    } else if (data.status) {
                         document.getElementById('qrCodeContainer').innerHTML = '<div style="color:#10b981; font-size: 1.1rem; font-weight: 700;">✅ Connected (' + data.status + ')</div>';
                    } else {
                        document.getElementById('qrCodeContainer').innerHTML = '<div style="color:#ef4444; background: #fee2e2; padding: 1rem; border-radius: 8px; font-size: 0.85rem; text-align: left; overflow-wrap: break-word;"><strong>Error:</strong> ' + (data.error || 'Could not generate QR Code') + '</div>';
                    }
                })
                .catch(err => {
                    document.getElementById('qrCodeContainer').innerHTML = '<div style="color:#ef4444; background: #fee2e2; padding: 1rem; border-radius: 8px; font-size: 0.85rem;"><strong>Server Error:</strong> Evolution API is offline or unreachable.</div>';
                });
            });
        }
    </script>
}
