@model AdwiseAiPlatform.Models.Customer
@{ ViewData["Title"] = "Knowledge Base"; }

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
        <h1 style="margin: 0; font-size: 1.5rem; color: var(--text-primary);">AI Knowledge Base</h1>
        <p style="margin: 0.2rem 0 0 0; color: var(--text-muted); font-size: 0.9rem;">Train your WhatsApp Agent with custom facts, pricing, and rules.</p>
    </div>
    <div style="background: rgba(16, 185, 129, 0.1); color: #10B981; padding: 0.5rem 1rem; border-radius: 8px; font-weight: 600; font-size: 0.85rem;">
        @(Model.KnowledgeBases?.Count ?? 0) Active Rules
    </div>
</div>

<div class="responsive-grid grid-stack" style="grid-template-columns: 1fr 2.5fr;">
    <!-- Add Rule Form -->
    <div style="background: white; border: 1px solid var(--card-border); border-radius: 12px; padding: 1.5rem; height: fit-content;">
        <h3 style="margin-top: 0; margin-bottom: 1.5rem; font-size: 1.1rem; color: var(--text-primary);">Add New Rule</h3>
        <form method="post" action="/Client/AddKnowledge">
            <div style="margin-bottom: 1rem;">
                <label style="display: block; font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 0.3rem;">Topic Phrase</label>
                <input type="text" name="Topic" class="glass-input" placeholder="e.g. Refund Policy" required style="width: 100%; border: 1px solid var(--card-border); padding: 0.6rem; border-radius: 6px;" />
            </div>
            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 0.3rem;">Instruction / Content</label>
                <textarea name="Content" class="glass-input" rows="5" placeholder="Exactly what the AI should know or reply..." required style="width: 100%; border: 1px solid var(--card-border); padding: 0.6rem; border-radius: 6px; resize: vertical;"></textarea>
            </div>
            <button type="submit" style="width: 100%; background: #10B981; color: white; border: none; padding: 0.75rem; border-radius: 6px; font-weight: 600; cursor: pointer;">Inject to Memory</button>
        </form>
    </div>

    <!-- Active Rules List -->
    <div style="background: white; border: 1px solid var(--card-border); border-radius: 12px; padding: 1.5rem;">
        <h3 style="margin-top: 0; margin-bottom: 1.5rem; font-size: 1.1rem; color: var(--text-primary);">Trained Memories</h3>
        
        @if (Model.KnowledgeBases == null || Model.KnowledgeBases.Count == 0) {
            <div style="text-align: center; padding: 3rem; color: #94a3b8; border: 1px dashed var(--card-border); border-radius: 8px;">
                <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="margin-bottom: 1rem; opacity: 0.6;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                <p style="margin: 0;">No knowledge base rules found.</p>
                <p style="margin: 0; font-size: 0.8rem;">Add rules using the form to configure how your Agent replies.</p>
            </div>
        } else {
            <div style="display: flex; flex-direction: column; gap: 1rem;">
                @foreach(var kb in Model.KnowledgeBases.OrderByDescending(k => k.Id)) {
                    <div style="border: 1px solid var(--card-border); border-radius: 8px; padding: 1.2rem; position: relative; background: #f8fafc;">
                        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
                            <span style="width: 8px; height: 8px; background: #10B981; border-radius: 50%;"></span>
                            <h4 style="margin: 0; font-size: 1rem; color: #0f172a;">@kb.Topic</h4>
                        </div>
                        <p style="margin: 0; font-size: 0.85rem; color: #475569; line-height: 1.5; white-space: pre-wrap;">@kb.Content</p>
                        
                        <form method="post" action="/Client/DeleteKnowledge" style="position: absolute; top: 1rem; right: 1rem; margin: 0;">
                            <input type="hidden" name="id" value="@kb.Id" />
                            <button type="submit" style="background: transparent; border: none; color: #ef4444; cursor: pointer; padding: 0.2rem;" title="Remove Memory">
                                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
</div>
