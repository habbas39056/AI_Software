@model IEnumerable<AdwiseAiPlatform.Models.Customer>
@{ ViewData["Title"] = "Billing Management"; }

<div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem;">
    <div>
        <h1 style="margin-top: 0;">Billing & Subscription Control</h1>
        <p class="subtitle" style="margin-bottom: 0;">Monitor subscription statuses, renew clients, and manage portal access.</p>
    </div>
</div>

<!-- Stats Row -->
<div class="stat-cards-grid" style="margin-bottom: 2rem;">
    @{
        int activeCount = Model.Count(c => c.SubscriptionStatus == "Active");
        int suspendedCount = Model.Count(c => c.SubscriptionStatus == "Suspended");
        int warningCount = Model.Count(c => c.SubscriptionExpiry.HasValue && (c.SubscriptionExpiry.Value - DateTime.UtcNow).TotalDays <= 10 && (c.SubscriptionExpiry.Value - DateTime.UtcNow).TotalDays > 0);
        decimal totalRevenue = Model.Where(c => c.SubscriptionStatus == "Active").Sum(c => c.MonthlyFee);
    }
    <div class="stat-card green">
        <div class="stat-header">
            <h3 class="stat-title">Active Clients</h3>
        </div>
        <p class="stat-value">@activeCount</p>
    </div>
    <div class="stat-card orange">
        <div class="stat-header">
            <h3 class="stat-title">Expiring Soon (≤10d)</h3>
        </div>
        <p class="stat-value">@warningCount</p>
    </div>
    <div class="stat-card" style="border-left: 4px solid #ef4444;">
        <div class="stat-header">
            <h3 class="stat-title">Suspended</h3>
        </div>
        <p class="stat-value" style="color: #ef4444;">@suspendedCount</p>
    </div>
    <div class="stat-card blue">
        <div class="stat-header">
            <h3 class="stat-title">Monthly Revenue (PKR)</h3>
        </div>
        <p class="stat-value">@totalRevenue.ToString("N0")</p>
    </div>
</div>

<!-- Clients Table -->
<div class="white-box" style="padding: 0;">
    <table class="glass-table">
        <thead>
            <tr>
                <th>Client</th>
                <th>Status</th>
                <th>Days Left</th>
                <th>Expiry</th>
                <th>Fee (PKR)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var c in Model) {
                int daysLeft = c.SubscriptionExpiry.HasValue ? (int)(c.SubscriptionExpiry.Value - DateTime.UtcNow).TotalDays : 0;
                if (daysLeft < 0) daysLeft = 0;
                string rowBg = c.SubscriptionStatus == "Suspended" ? "rgba(239,68,68,0.03)" : daysLeft <= 3 ? "rgba(239,68,68,0.03)" : daysLeft <= 10 ? "rgba(245,158,11,0.03)" : "transparent";
                string statusColor = c.SubscriptionStatus == "Suspended" ? "#ef4444" : daysLeft <= 3 ? "#ef4444" : daysLeft <= 10 ? "#f59e0b" : "#10B981";
            <tr style="background: @rowBg;">
                <td style="font-weight: 600;">
                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                        <div style="width: 32px; height: 32px; background: rgba(16, 185, 129, 0.1); color: var(--brand-green); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700;">
                            @(!string.IsNullOrEmpty(c.Name) ? c.Name.Substring(0, 1) : "C")
                        </div>
                        <div>
                            <span style="display: block;">@c.Name</span>
                            <span style="font-size: 0.7rem; color: var(--text-muted); font-weight: 400;">@c.WhatsAppNumber</span>
                        </div>
                    </div>
                </td>
                <td>
                    <span style="display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.75rem; font-weight: 700; color: @statusColor; background: @(statusColor)15; padding: 0.2rem 0.6rem; border-radius: 20px; border: 1px solid @(statusColor)30;">
                        <span style="width: 6px; height: 6px; border-radius: 50%; background: @statusColor;"></span>
                        @c.SubscriptionStatus
                    </span>
                </td>
                <td>
                    <span style="font-weight: 700; color: @statusColor; font-size: 0.9rem;">@daysLeft</span>
                    <span style="font-size: 0.7rem; color: #94a3b8;"> days</span>
                </td>
                <td style="font-size: 0.8rem; color: var(--text-secondary);">
                    @(c.SubscriptionExpiry?.ToString("MMM dd, yyyy") ?? "N/A")
                </td>
                <td style="font-weight: 600;">@c.MonthlyFee.ToString("N0")</td>
                <td>
                    <div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
                        @if (c.SubscriptionStatus == "Suspended" || daysLeft <= 0) {
                        <!-- Renew Button -->
                        <form method="post" action="/Billing/ConfirmPayment" style="margin: 0; display: flex; gap: 0.3rem;">
                            <input type="hidden" name="customerId" value="@c.WhatsAppNumber" />
                            <input type="number" name="days" value="@c.SubscriptionDays" style="width: 50px; padding: 0.25rem; border: 1px solid var(--card-border); border-radius: 4px; font-size: 0.75rem; text-align: center;" />
                            <button type="submit" style="background: #10B981; color: white; border: none; padding: 0.3rem 0.7rem; border-radius: 6px; font-size: 0.7rem; font-weight: 700; cursor: pointer;">Renew</button>
                        </form>
                        } else {
                        <!-- Block Button -->
                        <form method="post" action="/Admin/ToggleSubscription" style="margin: 0;">
                            <input type="hidden" name="id" value="@c.WhatsAppNumber" />
                            <input type="hidden" name="status" value="Suspended" />
                            <button type="submit" style="background: #fee2e2; color: #ef4444; border: 1px solid #fca5a5; padding: 0.3rem 0.7rem; border-radius: 6px; font-size: 0.7rem; font-weight: 700; cursor: pointer;" onclick="return confirm('Block this client\'s portal?')">Block</button>
                        </form>
                        }

                        @if (c.SubscriptionStatus == "Suspended") {
                        <!-- Unblock Button -->
                        <form method="post" action="/Admin/ToggleSubscription" style="margin: 0;">
                            <input type="hidden" name="id" value="@c.WhatsAppNumber" />
                            <input type="hidden" name="status" value="Active" />
                            <button type="submit" style="background: #dcfce7; color: #166534; border: 1px solid #86efac; padding: 0.3rem 0.7rem; border-radius: 6px; font-size: 0.7rem; font-weight: 700; cursor: pointer;">Unblock</button>
                        </form>
                        }
                    </div>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>
