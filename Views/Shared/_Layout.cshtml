@using Microsoft.EntityFrameworkCore
@using AdwiseAiPlatform.Data
@inject ApplicationDbContext dbContext
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Adwise AI</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <input type="checkbox" id="sidebar-toggle">
    <div class="sidebar-overlay" onclick="document.getElementById('sidebar-toggle').checked = false;"></div>

    <header class="mobile-nav-header">
        <div class="brand" style="margin: 0; padding: 0; font-size: 1rem;">
            @if (User.IsInRole("Super Admin")) {
                <span>ADWISE</span> <span style="color: var(--brand-green);">AI</span>
            } else {
                <span>WhatsApp</span> <span style="color: var(--brand-green);">AI</span>
            }
        </div>
        <label for="sidebar-toggle" class="hamburger">
            <span></span>
            <span></span>
            <span></span>
        </label>
    </header>
    <aside class="sidebar">
        @if (User.IsInRole("Super Admin")) {
            <div class="brand">
                <div class="brand-icon">
                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                      <path d="M11.251.068a.5.5 0 0 1 .227.58L9.677 6.5H13a.5.5 0 0 1 .364.843l-8 8.5a.5.5 0 0 1-.842-.49L6.323 9.5H3a.5.5 0 0 1-.364-.843l8-8.5a.5.5 0 0 1 .615-.09z"/>
                    </svg>
                </div>
                ADWISE <span>AI</span>
            </div>
        } else {
            <div class="brand" style="color: #10B981; gap: 0.5rem; justify-content: flex-start; padding-left: 1.5rem;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.487-1.761-1.66-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a5.8 5.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
                </svg>
                WhatsApp <span>AI</span>
            </div>
        }
        
        <div class="sidebar-heading">MAIN MENU</div>
        <nav>
            @if (User.IsInRole("Super Admin")) 
            {
                <a href="/Admin/Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
                    Dashboard
                </a>
                <a href="/Admin/Clients" class="nav-link @((ViewContext.RouteData.Values["Action"]?.ToString() == "Clients" || ViewContext.RouteData.Values["Action"]?.ToString() == "AddCustomer" || ViewContext.RouteData.Values["Action"]?.ToString() == "EditCustomer" || ViewContext.RouteData.Values["Action"]?.ToString() == "Details") && ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "active" : "")">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                    CRM & Clients
                </a>
                <a href="/Billing/Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Billing" ? "active" : "")">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                    Analytics & Billing
                </a>
            } 
            else 
            {
                <a href="/Client/Index" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")" @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" || ViewContext.RouteData.Values["Action"] == null ? "style=\"color: #10B981; background: rgba(16, 185, 129, 0.1);\"" : "")>
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
                    Dashboard
                </a>
                <a href="/Client/KnowledgeBase" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "KnowledgeBase" ? "active" : "")" @(ViewContext.RouteData.Values["Action"]?.ToString() == "KnowledgeBase" ? "style=\"color: #10B981; background: rgba(16, 185, 129, 0.1);\"" : "")>
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                    Knowledge Base
                </a>
                <a href="/Client/Leads" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Leads" ? "active" : "")" @(ViewContext.RouteData.Values["Action"]?.ToString() == "Leads" ? "style=\"color: #10B981; background: rgba(16, 185, 129, 0.1);\"" : "")>
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                    Leads Center
                </a>
                <a href="/Client/Billing" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Billing" ? "active" : "")" @(ViewContext.RouteData.Values["Action"]?.ToString() == "Billing" ? "style=\"color: #10B981; background: rgba(16, 185, 129, 0.1);\"" : "")>
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    Billing & Plan
                </a>
            }
        </nav>
        
        @if (User.IsInRole("Super Admin")) 
        {
        <div class="sidebar-heading" style="margin-top: 1.5rem;">OPERATIONS</div>
        <nav>
            <a href="#" class="nav-link">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                System Logs
            </a>
            <a href="#" class="nav-link">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Global Leads
            </a>
        </nav>
        }

        <div class="sidebar-heading" style="margin-top: 1.5rem;">SETTINGS</div>
        <nav>
            @if (User.IsInRole("Super Admin")) {
                <a href="#" class="nav-link">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                    Security
                </a>
            } else {
                <a href="/Client/Settings" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Settings" ? "active" : "")" @(ViewContext.RouteData.Values["Action"]?.ToString() == "Settings" ? "style=\"color: #10B981; background: rgba(16, 185, 129, 0.1);\"" : "")>
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                    Agent Config
                </a>
                <a href="#" class="nav-link">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    Support Docs
                </a>
            }
        </nav>
        
        <div class="user-profile-widget" style="margin-top: 1rem;">
            <div class="user-avatar" style="@(!User.IsInRole("Super Admin") ? "background-color: #e0f2fe; color: #0ea5e9;" : "")">
                <div class="user-status"></div>
            </div>
            <div style="flex: 1;">
                <div style="font-weight: 600; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; overflow: hidden; width: 100px;">@User.Identity?.Name</div>
                <div style="color: var(--sidebar-text); font-size: 0.75rem;">@(User.IsInRole("Super Admin") ? "Super Admin" : "PRO ACCOUNT")</div>
            </div>
            <a href="/Auth/Logout" style="color: var(--text-muted);">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
            </a>
        </div>
    </aside>

    <main class="main-content">
        <div class="top-header">
            @if (User.IsInRole("Super Admin")) {
                <div class="header-title">
                    <h1>Agency Overview</h1>
                    <p>Monday, June 26, 2024</p>
                </div>
            } else {
                <div class="header-title">
                    <h1>Dashboard</h1>
                    <p style="color: #64748b; font-size: 0.8rem; font-weight: 500;">Overview <span style="margin: 0 0.5rem;">></span> <span style="color: #10B981;">Real-time Stats</span></p>
                </div>
            }
            
            <div class="header-actions">
                @{
                    var phoneNum = User.FindFirst("WhatsAppNumber")?.Value ?? User.FindFirst("CustomerId")?.Value;
                    bool agentLive = false;
                    string agentName = "No Agent";
                    if (!string.IsNullOrEmpty(phoneNum)) {
                        var cust = await dbContext.Customers.IgnoreQueryFilters()
                            .Include(c => c.Agents)
                            .FirstOrDefaultAsync(c => c.WhatsAppNumber == phoneNum);
                        if (cust?.Agents != null && cust.Agents.Any()) {
                            agentLive = cust.Agents.Any(a => a.IsActive);
                            agentName = cust.Agents.First().InstanceName ?? "Agent";
                        }
                    }
                }
                @if (User.IsInRole("Super Admin")) {
                    <div class="search-bar">
                        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--text-muted);"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        <input type="text" placeholder="Search metrics, logs, or clients..." />
                    </div>
                } else {
                    <div style="display: flex; align-items: center; border: 1px solid #e2e8f0; border-radius: 50px; padding: 0.4rem 1.5rem; gap: 1rem; margin-right: 1rem;">
                        <svg width="24" height="24" fill="none" stroke="@(agentLive ? "#10b981" : "#ef4444")" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                        <div style="line-height: 1.2;">
                            <div style="font-size: 0.8rem; font-weight: 600; color: #1e293b;">Agent: @(agentLive ? "Active" : "Offline") <span style="font-size: 0.65rem; color: @(agentLive ? "#10b981" : "#ef4444"); margin-left: 0.3rem;">● @(agentLive ? "Live" : "Paused")</span></div>
                            <div style="font-size: 0.7rem; color: #64748b;">@agentName <span style="margin: 0 0.4rem;">•</span> @DateTime.Now.ToShortDateString()</div>
                        </div>
                    </div>
                }

                <button class="icon-button">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
                </button>
                <button class="icon-button">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </button>
                
                @if (User.IsInRole("Super Admin")) {
                    <a href="/Admin/AddCustomer" class="btn-primary">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                        New AI Agent
                    </a>
                }
            </div>
        </div>

        <div class="dashboard-container">
            @RenderBody()
        </div>
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
